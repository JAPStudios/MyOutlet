import wixData from 'wix-data';
import wixUsersBackend from 'wix-users-backend';
import { createNotification } from 'backend/notifications';
import { applyViewerRatingPreference } from 'backend/ratingPreferences';

const MEDIA = 'MediaItems';
const CHANNELS = 'CreatorChannels';
const SONGS = 'SongRequests';
const UPLOADS = 'MediaUploadSessions';

function cleanText(value, field, max) {
  if (typeof value !== 'string') throw new Error(field + ' must be text.');
  const result = value.trim();
  if (!result || result.length > max) throw new Error(field + ' is required and must be at most ' + max + ' characters.');
  return result;
}

function safeHttpsUrl(value, field) {
  const raw = cleanText(value, field, 2048);
  let parsed;
  try { parsed = new URL(raw); } catch (_) { throw new Error(field + ' must be a valid HTTPS URL.'); }
  if (parsed.protocol !== 'https:') throw new Error(field + ' must use HTTPS.');
  return parsed.toString();
}

function safeImageUrl(value, field) {
  const raw = cleanText(value, field, 2048);
  if (raw.startsWith('wix:image://')) return raw;
  return safeHttpsUrl(raw, field);
}

function normalizeSocialLinks(value) {
  if (value === undefined || value === null) return [];
  if (!Array.isArray(value)) throw new Error('Social links must be an array of HTTPS URLs.');
  return [...new Set(value.map(link => safeHttpsUrl(link, 'Social link')))].slice(0, 10);
}

function optionalText(value, field, max) {
  if (value === undefined || value === null || value === '') return '';
  return cleanText(value, field, max);
}

function normalizeTags(value) {
  if (value === undefined || value === null) return [];
  if (!Array.isArray(value)) throw new Error('Tags must be an array of text values.');
  return [...new Set(value.map(tag => cleanText(tag, 'Tag', 30).toLowerCase()))].slice(0, 10);
}

function normalizeLanguage(value) {
  const raw = optionalText(value, 'Language', 5);
  if (!raw) return '';
  if (!/^[a-z]{2}(?:-[a-z]{2})?$/i.test(raw)) {
    throw new Error('Language must use an ISO 639-1 code, optionally followed by an ISO 3166-1 alpha-2 region.');
  }
  const parts = raw.split('-');
  return parts[0].toLowerCase() + (parts[1] ? '-' + parts[1].toUpperCase() : '');
}

function normalizeDuration(value) {
  if (value === undefined || value === null || value === '') return 0;
  const duration = Number(value);
  if (!Number.isInteger(duration) || duration < 0 || duration > 86400) {
    throw new Error('Duration must be a whole number between 0 and 86400 seconds.');
  }
  return duration;
}

function applyMediaFilters(query, options = {}) {
  const category = optionalText(options.category, 'Category', 50);
  const contentType = optionalText(options.contentType, 'Content type', 20);
  const contentRating = optionalText(options.contentRating, 'Content rating', 20);
  const language = normalizeLanguage(options.language);
  const tag = optionalText(options.tag, 'Tag', 30).toLowerCase();

  if (contentType && !TYPES.includes(contentType)) throw new Error('Unsupported content type filter.');
  if (contentRating && !RATINGS.includes(contentRating)) throw new Error('Unsupported content rating filter.');

  if (category) query = query.eq('category', category);
  if (contentType) query = query.eq('contentType', contentType);
  if (contentRating) query = query.eq('contentRating', contentRating);
  if (language) query = query.eq('language', language);
  if (tag) query = query.hasSome('tags', [tag]);
  return query;
}

function memberId() {
  const id = wixUsersBackend.currentUser && wixUsersBackend.currentUser.id;
  if (!id) throw new Error('A signed-in site member is required.');
  return id;
}

function publicMedia(item) {
  return {
    _id: item._id,
    title: item.title,
    description: item.description || '',
    mediaUrl: item.mediaUrl,
    thumbnailUrl: item.thumbnailUrl || '',
    contentType: item.contentType,
    contentRating: item.contentRating,
    category: item.category || 'Other',
    tags: Array.isArray(item.tags) ? item.tags : [],
    language: item.language || '',
    durationSeconds: Number(item.durationSeconds) || 0,
    creatorChannelId: item.creatorChannelId,
    publishedAt: item.publishedAt || item._createdDate
  };
}

const RATINGS = ['TV-Y', 'TV-Y7', 'TV-G', 'TV-PG', 'TV-14', 'TV-MA', 'Unrated'];
const TYPES = ['video', 'livestream', 'audio'];


function publicChannel(channel) {
  return {
    _id: channel._id,
    name: channel.name,
    handle: channel.handle,
    description: channel.description || '',
    avatarUrl: channel.avatarUrl || '',
    bannerUrl: channel.bannerUrl || '',
    websiteUrl: channel.websiteUrl || '',
    socialLinks: Array.isArray(channel.socialLinks) ? channel.socialLinks : [],
    createdAt: channel.createdAt,
    updatedAt: channel.updatedAt
  };
}

export async function browseCreators(options = {}) {
  const requestedLimit = Number(options.limit);
  const requestedOffset = Number(options.offset);
  const limit = Math.min(Math.max(Number.isFinite(requestedLimit) && requestedLimit ? requestedLimit : 24, 1), 50);
  const offset = Math.min(Math.max(Number.isFinite(requestedOffset) ? requestedOffset : 0, 0), 10000);
  const result = await wixData.query(CHANNELS)
    .ascending('name')
    .skip(offset)
    .limit(limit)
    .find({ suppressAuth: true });
  return {
    items: result.items.map(publicChannel),
    total: result.totalCount,
    offset,
    limit
  };
}

export async function searchCreators(options = {}) {
  const term = cleanText(options.term, 'Search term', 100);
  const requestedLimit = Number(options.limit);
  const limit = Math.min(Math.max(Number.isFinite(requestedLimit) && requestedLimit ? requestedLimit : 24, 1), 50);
  const nameQuery = wixData.query(CHANNELS).contains('name', term);
  const handleQuery = wixData.query(CHANNELS).contains('handle', term.toLowerCase().replace(/^@/, ''));
  const descriptionQuery = wixData.query(CHANNELS).contains('description', term);
  const result = await nameQuery.or(handleQuery).or(descriptionQuery)
    .ascending('name')
    .limit(limit)
    .find({ suppressAuth: true });
  return { items: result.items.map(publicChannel), total: result.totalCount };
}

export async function getCreatorProfile(input = {}) {
  const handle = cleanText(input.handle, 'Creator handle', 30).replace(/^@/, '').toLowerCase();
  const result = await wixData.query(CHANNELS)
    .eq('handle', handle)
    .limit(1)
    .find({ suppressAuth: true });
  if (!result.items.length) return null;
  const channel = result.items[0];
  const member = wixUsersBackend.currentUser && wixUsersBackend.currentUser.id;
  const mediaQuery = await applyViewerRatingPreference(
    wixData.query(MEDIA).eq('creatorChannelId', channel._id).eq('status', 'published'),
    member
  );
  const media = await mediaQuery
    .descending('publishedAt')
    .limit(24)
    .find({ suppressAuth: true });
  return {
    channel: publicChannel(channel),
    media: media.items.map(publicMedia),
    totalMedia: media.totalCount
  };
}

export async function browseCatalog(options = {}) {
  const limit = Math.min(Math.max(Number(options.limit) || 24, 1), 50);
  const offset = Math.min(Math.max(Number(options.offset) || 0, 0), 10000);
  const query = applyMediaFilters(wixData.query(MEDIA).eq('status', 'published'), options);
  const member = wixUsersBackend.currentUser && wixUsersBackend.currentUser.id;
  const filteredQuery = await applyViewerRatingPreference(query, member);
  const result = await filteredQuery
    .descending('publishedAt')
    .skip(offset)
    .limit(limit)
    .find({ suppressAuth: true });
  return { items: result.items.map(publicMedia), total: result.totalCount, offset, limit };
}

export async function searchCatalog(options = {}) {
  const term = cleanText(options.term, 'Search term', 100);
  const limit = Math.min(Math.max(Number(options.limit) || 24, 1), 50);
  const offset = Math.min(Math.max(Number(options.offset) || 0, 0), 10000);
  const titleQuery = wixData.query(MEDIA).eq('status', 'published').contains('title', term);
  const descriptionQuery = wixData.query(MEDIA).eq('status', 'published').contains('description', term);
  const categoryQuery = wixData.query(MEDIA).eq('status', 'published').contains('category', term);
  const tagQuery = wixData.query(MEDIA).eq('status', 'published').hasSome('tags', [term.toLowerCase()]);
  const query = applyMediaFilters(titleQuery.or(descriptionQuery).or(categoryQuery).or(tagQuery), options);
  const member = wixUsersBackend.currentUser && wixUsersBackend.currentUser.id;
  const filteredQuery = await applyViewerRatingPreference(query, member);
  const result = await filteredQuery
    .descending('publishedAt')
    .skip(offset)
    .limit(limit)
    .find({ suppressAuth: true });
  return { items: result.items.map(publicMedia), total: result.totalCount, offset, limit };
}

export async function getMyChannel() {
  const ownerId = memberId();
  const result = await wixData.query(CHANNELS).eq('memberId', ownerId).limit(1).find({ suppressAuth: true });
  if (!result.items.length) return null;
  return publicChannel(result.items[0]);
}

export async function saveMyChannel(input = {}) {
  const ownerId = memberId();
  const name = cleanText(input.name, 'Channel name', 80);
  const handle = cleanText(input.handle, 'Channel handle', 30).replace(/^@/, '').toLowerCase();
  if (!/^[a-z0-9_]+$/.test(handle)) throw new Error('Channel handle may contain only lowercase letters, numbers and underscores.');
  const description = typeof input.description === 'string' ? input.description.trim().slice(0, 500) : '';
  const found = await wixData.query(CHANNELS).eq('memberId', ownerId).limit(1).find({ suppressAuth: true });
  const existing = found.items[0] || null;
  const collision = await wixData.query(CHANNELS).eq('handle', handle).limit(1).find({ suppressAuth: true });
  if (collision.items.length && (!existing || collision.items[0]._id !== existing._id)) {
    throw new Error('That channel handle is already in use.');
  }
  const avatarUrl = input.avatarUrl === undefined
    ? (existing ? existing.avatarUrl || '' : '')
    : (input.avatarUrl ? safeImageUrl(input.avatarUrl, 'Avatar URL') : '');
  const bannerUrl = input.bannerUrl === undefined
    ? (existing ? existing.bannerUrl || '' : '')
    : (input.bannerUrl ? safeImageUrl(input.bannerUrl, 'Banner URL') : '');
  const websiteUrl = input.websiteUrl === undefined
    ? (existing ? existing.websiteUrl || '' : '')
    : (input.websiteUrl ? safeHttpsUrl(input.websiteUrl, 'Website URL') : '');
  const socialLinks = input.socialLinks === undefined
    ? (existing && Array.isArray(existing.socialLinks) ? existing.socialLinks : [])
    : normalizeSocialLinks(input.socialLinks);
  const now = new Date();
  const record = {
    name, handle, description, avatarUrl, bannerUrl, websiteUrl, socialLinks,
    memberId: ownerId,
    createdAt: existing ? existing.createdAt || now : now,
    updatedAt: now
  };
  if (existing) {
    const updated = await wixData.update(CHANNELS, { ...existing, ...record }, { suppressAuth: true });
    return publicChannel(updated);
  }
  const created = await wixData.insert(CHANNELS, record, { suppressAuth: true });
  return publicChannel(created);
}

export async function submitContent(input = {}) {
  const creatorId = memberId();
  const title = cleanText(input.title, 'Title', 120);
  const description = typeof input.description === 'string' ? input.description.trim().slice(0, 2000) : '';
  const thumbnailUrl = input.thumbnailUrl ? safeHttpsUrl(input.thumbnailUrl, 'Thumbnail URL') : '';
  const contentType = cleanText(input.contentType, 'Content type', 20);
  const contentRating = cleanText(input.contentRating, 'Content rating', 20);
  if (!TYPES.includes(contentType)) throw new Error('Unsupported content type.');
  if (!RATINGS.includes(contentRating)) throw new Error('Unsupported content rating.');
  const category = optionalText(input.category, 'Category', 50) || 'Other';
  const tags = normalizeTags(input.tags);
  const language = normalizeLanguage(input.language);
  const durationSeconds = normalizeDuration(input.durationSeconds);
  const channelId = cleanText(input.creatorChannelId, 'Creator channel', 100);
  const channel = await wixData.get(CHANNELS, channelId, { suppressAuth: true });
  if (!channel || channel.memberId !== creatorId) throw new Error('The selected channel is not available to this account.');

  let mediaUrl;
  let uploadSessionId = '';
  if (input.mediaUploadSessionId) {
    uploadSessionId = cleanText(input.mediaUploadSessionId, 'Media upload session', 100);
    if (contentType !== 'video') throw new Error('Uploaded MP4 sessions can only be submitted as video.');
    const session = await wixData.get(UPLOADS, uploadSessionId, { suppressAuth: true });
    if (!session || session.ownerMemberId !== creatorId || session.status !== 'ready' || !session.fileUrl) {
      throw new Error('The video upload is not ready for submission.');
    }
    if (session.mediaType !== 'video' || !session.fileUrl.startsWith('wix:video://')) {
      throw new Error('The uploaded file is not a ready Wix video.');
    }
    if (session.mediaItemId) throw new Error('This uploaded video has already been submitted.');
    mediaUrl = session.fileUrl;
  } else {
    mediaUrl = safeHttpsUrl(input.mediaUrl, 'Media URL');
  }

  const created = await wixData.insert(MEDIA, {
    title, description, mediaUrl, thumbnailUrl, contentType, contentRating,
    category, tags, language, durationSeconds,
    creatorChannelId: channelId, creatorMemberId: creatorId,
    mediaUploadSessionId: uploadSessionId,
    status: 'pending_review', submittedAt: new Date()
  }, { suppressAuth: true });

  if (uploadSessionId) {
    const session = await wixData.get(UPLOADS, uploadSessionId, { suppressAuth: true });
    await wixData.update(UPLOADS, {
      ...session,
      status: 'submitted',
      mediaItemId: created._id,
      submittedAt: new Date()
    }, { suppressAuth: true });
  }
  return { _id: created._id, status: created.status, title: created.title };
}

export async function getSongQueue(options = {}) {
  const channelId = cleanText(options.creatorChannelId, 'Creator channel', 100);
  const channel = await wixData.get(CHANNELS, channelId, { suppressAuth: true });
  if (!channel) throw new Error('Creator channel was not found.');
  const limit = Math.min(Math.max(Number(options.limit) || 50, 1), 100);
  const result = await wixData.query(SONGS)
    .eq('creatorChannelId', channelId)
    .eq('status', 'queued')
    .ascending('_createdDate')
    .limit(limit)
    .find({ suppressAuth: true });
  return {
    items: result.items.map(item => ({
      _id: item._id, title: item.title, artist: item.artist,
      creatorChannelId: item.creatorChannelId, requestedAt: item._createdDate
    }))
  };
}

export async function enqueueSong(input = {}) {
  const requesterId = memberId();
  const title = cleanText(input.title, 'Song title', 120);
  const artist = cleanText(input.artist, 'Artist', 120);
  const channelId = cleanText(input.creatorChannelId, 'Creator channel', 100);
  const channel = await wixData.get(CHANNELS, channelId, { suppressAuth: true });
  if (!channel) throw new Error('Creator channel was not found.');
  const created = await wixData.insert(SONGS, {
    title, artist, creatorChannelId: channelId,
    requesterMemberId: requesterId, status: 'queued'
  }, { suppressAuth: true });
  if (channel.memberId !== requesterId) {
    await createNotification({
      recipientMemberId: channel.memberId,
      actorMemberId: requesterId,
      type: 'song_request',
      creatorChannelId: channelId,
      sourceId: created._id,
      message: 'A new song request was added to the channel queue.'
    });
  }
  return { _id: created._id, title: created.title, artist: created.artist, status: created.status };
}

export async function moderateContent(input = {}) {
  const id = cleanText(input.contentId, 'Content ID', 100);
  const status = cleanText(input.status, 'Status', 30);
  if (!['published', 'rejected', 'removed'].includes(status)) throw new Error('Unsupported moderation status.');
  const existing = await wixData.get(MEDIA, id, { suppressAuth: true });
  if (!existing) throw new Error('Content item was not found.');
  const updated = await wixData.update(MEDIA, {
    ...existing, status,
    publishedAt: status === 'published' ? new Date() : existing.publishedAt,
    moderationNote: typeof input.note === 'string' ? input.note.trim().slice(0, 1000) : ''
  }, { suppressAuth: true });
  return { _id: updated._id, status: updated.status };
}

export async function getCreatorCatalog(input = {}) {
  const channelId = cleanText(input.creatorChannelId, 'Creator channel', 100);
  const limit = Math.min(Math.max(Number(input.limit) || 24, 1), 50);
  const query = applyMediaFilters(
    wixData.query(MEDIA).eq('creatorChannelId', channelId).eq('status', 'published'),
    input
  );
  const member = wixUsersBackend.currentUser && wixUsersBackend.currentUser.id;
  const filteredQuery = await applyViewerRatingPreference(query, member);
  const result = await filteredQuery
    .descending('publishedAt')
    .limit(limit)
    .find({ suppressAuth: true });
  return { items: result.items.map(publicMedia), total: result.totalCount };
}

export async function getMySubmissions(options = {}) {
  const creatorId = memberId();
  const limit = Math.min(Math.max(Number(options.limit) || 50, 1), 100);
  const result = await wixData.query(MEDIA)
    .eq('creatorMemberId', creatorId)
    .descending('submittedAt')
    .limit(limit)
    .find({ suppressAuth: true });
  return {
    items: result.items.map(item => ({
      _id: item._id, title: item.title, contentType: item.contentType,
      contentRating: item.contentRating, category: item.category || 'Other',
      tags: Array.isArray(item.tags) ? item.tags : [], language: item.language || '',
      durationSeconds: Number(item.durationSeconds) || 0, status: item.status,
      submittedAt: item.submittedAt, moderationNote: item.moderationNote || ''
    }))
  };
}

export async function listPendingContent(options = {}) {
  const limit = Math.min(Math.max(Number(options.limit) || 50, 1), 100);
  const result = await wixData.query(MEDIA)
    .eq('status', 'pending_review')
    .ascending('submittedAt')
    .limit(limit)
    .find({ suppressAuth: true });
  return {
    items: result.items.map(item => ({
      _id: item._id, title: item.title, description: item.description || '',
      mediaUrl: item.mediaUrl, contentType: item.contentType,
      contentRating: item.contentRating, category: item.category || 'Other',
      tags: Array.isArray(item.tags) ? item.tags : [], language: item.language || '',
      durationSeconds: Number(item.durationSeconds) || 0, creatorChannelId: item.creatorChannelId,
      submittedAt: item.submittedAt
    }))
  };
}

export async function setSongRequestStatus(input = {}) {
  const ownerId = memberId();
  const id = cleanText(input.requestId, 'Song request ID', 100);
  const status = cleanText(input.status, 'Song request status', 20);
  if (!['played', 'skipped', 'cancelled'].includes(status)) throw new Error('Unsupported song request status.');
  const existing = await wixData.get(SONGS, id, { suppressAuth: true });
  if (!existing) throw new Error('Song request was not found.');
  const channel = await wixData.get(CHANNELS, existing.creatorChannelId, { suppressAuth: true });
  if (!channel || channel.memberId !== ownerId) {
    throw new Error('Only the owner of this creator channel can update its song queue.');
  }
  const updated = await wixData.update(SONGS, { ...existing, status }, { suppressAuth: true });
  return { _id: updated._id, status: updated.status };
}
