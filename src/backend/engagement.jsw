import wixData from 'wix-data';
import wixUsersBackend from 'wix-users-backend';
import { isContentRatingAllowed } from 'backend/ratingPreferences';
import { isMediaRightsCurrent } from 'backend/rightsCore';
import { createNotification } from 'backend/notifications';

const MEDIA = 'MediaItems';
const LIKES = 'MediaLikes';
const COMMENTS = 'MediaComments';
const CHANNELS = 'CreatorChannels';


export async function listMyPendingComments(options = {}) {
  const ownerId = memberId();
  const requested = Number(options.limit);
  const requestedOffset = Number(options.offset);
  const limit = Math.min(Math.max(Number.isFinite(requested) && requested ? requested : 50, 1), 100);
  const offset = Math.min(Math.max(Number.isFinite(requestedOffset) ? requestedOffset : 0, 0), 10000);
  const channels = await wixData.query(CHANNELS)
    .eq('memberId', ownerId)
    .limit(100)
    .find({ suppressAuth: true });
  const channelIds = channels.items.map(channel => channel._id);
  if (!channelIds.length) return { items: [], total: 0 };

  const mediaResult = await wixData.query(MEDIA)
    .hasSome('creatorChannelId', channelIds)
    .limit(1000)
    .find({ suppressAuth: true });
  const mediaIds = mediaResult.items.map(media => media._id);
  if (!mediaIds.length) return { items: [], total: 0 };

  const pending = await wixData.query(COMMENTS)
    .hasSome('mediaItemId', mediaIds)
    .eq('status', 'pending_review')
    .ascending('updatedAt')
    .skip(offset)
    .limit(limit)
    .find({ suppressAuth: true, returnTotalCount: true });
  const mediaById = new Map(mediaResult.items.map(media => [media._id, media]));
  const items = pending.items
    .map(comment => {
      const media = mediaById.get(comment.mediaItemId);
      return {
        _id: comment._id,
        mediaItemId: comment.mediaItemId,
        mediaTitle: media.title,
        memberId: comment.memberId,
        body: comment.body,
        createdAt: comment.createdAt,
        updatedAt: comment.updatedAt
      };
    });
  return { items, total: pending.totalCount, offset, limit };
}

export async function moderateMyChannelComment(input = {}) {
  const ownerId = memberId();
  const commentId = requiredText(input.commentId, 'Comment ID', 100);
  const status = requiredText(input.status, 'Comment status', 20);
  const note = typeof input.note === 'string' ? input.note.trim().slice(0, 1000) : '';
  if (!['published', 'removed'].includes(status)) {
    throw new Error('Comment status must be published or removed.');
  }
  const comment = await wixData.get(COMMENTS, commentId, { suppressAuth: true });
  if (!comment) throw new Error('Comment was not found.');
  const media = await wixData.get(MEDIA, comment.mediaItemId, { suppressAuth: true });
  if (!media) throw new Error('The associated media item was not found.');
  const channel = await wixData.get(CHANNELS, media.creatorChannelId, { suppressAuth: true });
  if (!channel || channel.memberId !== ownerId) {
    throw new Error('Only the owner of this creator channel can moderate its comments.');
  }
  const updated = await wixData.update(COMMENTS, {
    ...comment,
    status,
    moderationNote: note,
    updatedAt: new Date()
  }, { suppressAuth: true });
  return { _id: updated._id, status: updated.status };
}

function memberId() {
  const id = wixUsersBackend.currentUser && wixUsersBackend.currentUser.id;
  if (!id) throw new Error('A signed-in site member is required.');
  return id;
}

function requiredText(value, field, max) {
  if (typeof value !== 'string') throw new Error(field + ' must be text.');
  const result = value.trim();
  if (!result || result.length > max) {
    throw new Error(field + ' is required and must be at most ' + max + ' characters.');
  }
  return result;
}

async function publishedMedia(mediaItemId) {
  const media = await wixData.get(MEDIA, mediaItemId, { suppressAuth: true });
  if (!media || media.status !== 'published' || !isMediaRightsCurrent(media)) {
    throw new Error('Published media was not found.');
  }
  const viewerId = wixUsersBackend.currentUser && wixUsersBackend.currentUser.id;
  if (!await isContentRatingAllowed(media.contentRating, viewerId)) {
    throw new Error('This media exceeds the selected content-rating preference.');
  }
  return media;
}

export async function likeMedia(input = {}) {
  const viewerId = memberId();
  const mediaItemId = requiredText(input.mediaItemId, 'Media item ID', 100);
  await publishedMedia(mediaItemId);
  const likeKey = mediaItemId + ':' + viewerId;
  const existing = await wixData.query(LIKES)
    .eq('likeKey', likeKey)
    .limit(1)
    .find({ suppressAuth: true });
  if (existing.items.length) {
    return { liked: true, alreadyLiked: true };
  }

  try {
    await wixData.insert(LIKES, {
      likeKey,
      mediaItemId,
      memberId: viewerId,
      createdAt: new Date()
    }, { suppressAuth: true });
  } catch (error) {
    const duplicate = await wixData.query(LIKES)
      .eq('likeKey', likeKey)
      .limit(1)
      .find({ suppressAuth: true });
    if (!duplicate.items.length) throw error;
    return { liked: true, alreadyLiked: true };
  }
  return { liked: true, alreadyLiked: false };
}

export async function unlikeMedia(input = {}) {
  const viewerId = memberId();
  const mediaItemId = requiredText(input.mediaItemId, 'Media item ID', 100);
  const likeKey = mediaItemId + ':' + viewerId;
  const existing = await wixData.query(LIKES)
    .eq('likeKey', likeKey)
    .limit(1)
    .find({ suppressAuth: true });
  if (existing.items.length) {
    await wixData.remove(LIKES, existing.items[0]._id, { suppressAuth: true });
  }
  return { liked: false };
}

export async function getMediaEngagement(input = {}) {
  const mediaItemId = requiredText(input.mediaItemId, 'Media item ID', 100);
  await publishedMedia(mediaItemId);
  const viewerId = wixUsersBackend.currentUser && wixUsersBackend.currentUser.id;
  const likeQuery = wixData.query(LIKES).eq('mediaItemId', mediaItemId);
  const commentQuery = wixData.query(COMMENTS)
    .eq('mediaItemId', mediaItemId)
    .eq('status', 'published');
  const [likeCount, commentCount, viewerLike] = await Promise.all([
    likeQuery.count({ suppressAuth: true }),
    commentQuery.count({ suppressAuth: true }),
    viewerId
      ? wixData.query(LIKES).eq('likeKey', mediaItemId + ':' + viewerId)
          .limit(1).find({ suppressAuth: true })
      : Promise.resolve({ items: [] })
  ]);
  return {
    mediaItemId,
    likes: likeCount,
    comments: commentCount,
    likedByCurrentMember: viewerLike.items.length > 0
  };
}

export async function addComment(input = {}) {
  const viewerId = memberId();
  const mediaItemId = requiredText(input.mediaItemId, 'Media item ID', 100);
  const media = await publishedMedia(mediaItemId);
  const body = requiredText(input.body, 'Comment', 2000);
  const now = new Date();
  const created = await wixData.insert(COMMENTS, {
    mediaItemId,
    memberId: viewerId,
    body,
    status: 'published',
    createdAt: now,
    updatedAt: now
  }, { suppressAuth: true });
  const channel = await wixData.get(CHANNELS, media.creatorChannelId, { suppressAuth: true });
  if (channel && channel.memberId !== viewerId) {
    try {
      await createNotification({
        recipientMemberId: channel.memberId,
        actorMemberId: viewerId,
        type: 'new_comment',
        mediaItemId,
        creatorChannelId: channel._id,
        sourceId: created._id,
        message: 'A viewer commented on your media.'
      });
    } catch (error) {
      console.error('MyOutlet comment notification failed.', error);
    }
  }
  return { _id: created._id, mediaItemId, body: created.body, status: created.status, createdAt: created.createdAt };
}

export async function editComment(input = {}) {
  const viewerId = memberId();
  const commentId = requiredText(input.commentId, 'Comment ID', 100);
  const body = requiredText(input.body, 'Comment', 2000);
  const comment = await wixData.get(COMMENTS, commentId, { suppressAuth: true });
  if (!comment || comment.memberId !== viewerId) {
    throw new Error('Only the comment author can edit this comment.');
  }
  await publishedMedia(comment.mediaItemId);
  const updated = await wixData.update(COMMENTS, {
    ...comment,
    body,
    status: 'pending_review',
    updatedAt: new Date()
  }, { suppressAuth: true });
  return { _id: updated._id, status: updated.status, body: updated.body };
}

export async function deleteComment(input = {}) {
  const viewerId = memberId();
  const commentId = requiredText(input.commentId, 'Comment ID', 100);
  const comment = await wixData.get(COMMENTS, commentId, { suppressAuth: true });
  if (!comment || comment.memberId !== viewerId) {
    throw new Error('Only the comment author can delete this comment.');
  }
  await wixData.remove(COMMENTS, commentId, { suppressAuth: true });
  return { deleted: true, commentId };
}

export async function listComments(input = {}) {
  const mediaItemId = requiredText(input.mediaItemId, 'Media item ID', 100);
  await publishedMedia(mediaItemId);
  const requested = Number(input.limit);
  const requestedOffset = Number(input.offset);
  const limit = Math.min(Math.max(Number.isFinite(requested) && requested ? requested : 30, 1), 100);
  const offset = Math.min(Math.max(Number.isFinite(requestedOffset) ? requestedOffset : 0, 0), 10000);
  const result = await wixData.query(COMMENTS)
    .eq('mediaItemId', mediaItemId)
    .eq('status', 'published')
    .ascending('createdAt')
    .skip(offset)
    .limit(limit)
    .find({ suppressAuth: true, returnTotalCount: true });
  return {
    items: result.items.map(comment => ({
      _id: comment._id,
      body: comment.body,
      createdAt: comment.createdAt,
      updatedAt: comment.updatedAt
    })),
    total: result.totalCount,
    offset,
    limit
  };
}

export async function listPendingComments(options = {}) {
  const requested = Number(options.limit);
  const limit = Math.min(Math.max(Number.isFinite(requested) && requested ? requested : 50, 1), 100);
  const result = await wixData.query(COMMENTS)
    .eq('status', 'pending_review')
    .ascending('updatedAt')
    .limit(limit)
    .find({ suppressAuth: true, returnTotalCount: true });
  const items = await Promise.all(result.items.map(async comment => {
    let media = null;
    try {
      media = await wixData.get(MEDIA, comment.mediaItemId, { suppressAuth: true });
    } catch (_) {
      media = null;
    }
    return {
      _id: comment._id,
      mediaItemId: comment.mediaItemId,
      mediaTitle: media ? media.title : '',
      memberId: comment.memberId,
      body: comment.body,
      createdAt: comment.createdAt,
      updatedAt: comment.updatedAt
    };
  }));
  return { items, total: result.totalCount };
}

export async function moderateComment(input = {}) {
  const commentId = requiredText(input.commentId, 'Comment ID', 100);
  const status = requiredText(input.status, 'Comment status', 20);
  const note = typeof input.note === 'string' ? input.note.trim().slice(0, 1000) : '';
  if (!['published', 'removed'].includes(status)) {
    throw new Error('Comment status must be published or removed.');
  }
  const comment = await wixData.get(COMMENTS, commentId, { suppressAuth: true });
  if (!comment) throw new Error('Comment was not found.');
  const updated = await wixData.update(COMMENTS, {
    ...comment,
    status,
    moderationNote: note,
    updatedAt: new Date()
  }, { suppressAuth: true });
  return { _id: updated._id, status: updated.status };
}
