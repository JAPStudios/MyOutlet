import wixData from 'wix-data';
import wixUsersBackend from 'wix-users-backend';
import { isContentRatingAllowed } from 'backend/ratingPreferences';
import { isMediaRightsCurrent } from 'backend/rightsCore';

const CHAT = 'LiveChatMessages';
const REPORTS = 'LiveChatReports';
const BANS = 'LiveChatBans';
const REPORT_REASONS = ['harassment', 'hate', 'sexual_content', 'violence', 'self_harm', 'spam', 'threats', 'other'];
const LIVE = 'LiveStreams';
const MEDIA = 'MediaItems';
const CHANNELS = 'CreatorChannels';

function memberId() {
  const id = wixUsersBackend.currentUser && wixUsersBackend.currentUser.id;
  if (!id) throw new Error('A signed-in site member is required.');
  return id;
}

function requiredText(value, field, max) {
  if (typeof value !== 'string') throw new Error(field + ' must be text.');
  const result = value.trim();
  if (!result || result.length > max) {
    throw new Error(field + ' is required and must be at most ' + max + ' characters.');
  }
  return result;
}

async function getLiveContext(streamId) {
  const stream = await wixData.get(LIVE, streamId, { suppressAuth: true });
  if (!stream || stream.status !== 'live') {
    throw new Error('Live chat is available only while the stream is live.');
  }
  const media = await wixData.get(MEDIA, stream.mediaItemId, { suppressAuth: true });
  if (!media || media.status !== 'published' || !isMediaRightsCurrent(media)) {
    throw new Error('Live chat is unavailable because the stream or its distribution rights are unavailable.');
  }
  const viewerId = wixUsersBackend.currentUser && wixUsersBackend.currentUser.id;
  if (!await isContentRatingAllowed(media.contentRating, viewerId)) {
    throw new Error('This stream exceeds the selected content-rating preference.');
  }
  const channel = await wixData.get(CHANNELS, stream.creatorChannelId, { suppressAuth: true });
  if (!channel) throw new Error('The creator channel for this stream was not found.');
  return { stream, media, channel };
}

function publicMessage(item, stream, channel) {
  return {
    _id: item._id,
    liveStreamId: item.liveStreamId,
    senderName: item.senderName || (item.senderMemberId === stream.creatorMemberId ? channel.name : 'Viewer'),
    isCreator: item.senderMemberId === stream.creatorMemberId,
    body: item.body,
    createdAt: item.createdAt
  };
}

export async function getLiveChatMessages(input = {}) {
  const streamId = requiredText(input.streamId, 'Live-stream ID', 100);
  const { stream, channel } = await getLiveContext(streamId);
  const requested = Number(input.limit);
  const limit = Math.min(Math.max(Number.isFinite(requested) && requested ? requested : 50, 1), 100);
  const after = input.after === undefined || input.after === null || input.after === ''
    ? null
    : new Date(input.after);
  if (after && !Number.isFinite(after.getTime())) {
    throw new Error('The chat cursor must be a valid date and time.');
  }

  let query = wixData.query(CHAT)
    .eq('liveStreamId', streamId)
    .eq('status', 'published');
  if (after) {
    query = query.gt('createdAt', after).ascending('createdAt');
  } else {
    query = query.descending('createdAt');
  }
  const result = await query.limit(limit).find({ suppressAuth: true });
  const items = after ? result.items : result.items.reverse();
  return {
    liveStreamId: streamId,
    items: items.map(item => publicMessage(item, stream, channel)),
    nextAfter: items.length ? items[items.length - 1].createdAt : (after || null),
    live: true
  };
}

async function assertNotBannedFromChannel(channelId, bannedMemberId) {
  const result = await wixData.query(BANS)
    .eq('creatorChannelId', channelId)
    .eq('bannedMemberId', bannedMemberId)
    .eq('status', 'active')
    .limit(10)
    .find({ suppressAuth: true });
  for (const ban of result.items) {
    if (ban.expiresAt && new Date(ban.expiresAt).getTime() <= Date.now()) {
      await wixData.update(BANS, {
        ...ban,
        status: 'expired'
      }, { suppressAuth: true });
      continue;
    }
    throw new Error(ban.expiresAt
      ? 'This account is timed out from this creator channel live chat.'
      : 'This account is banned from this creator channel live chat.');
  }
}

export async function sendLiveChatMessage(input = {}) {
  const senderMemberId = memberId();
  const streamId = requiredText(input.streamId, 'Live-stream ID', 100);
  const body = requiredText(input.body, 'Message', 500);
  if (/[\u0000-\u0008\u000B\u000C\u000E-\u001F\u007F]/.test(body)) {
    throw new Error('Messages cannot contain control characters.');
  }
  const { stream, channel } = await getLiveContext(streamId);
  await assertNotBannedFromChannel(channel._id, senderMemberId);
  let senderName = senderMemberId === stream.creatorMemberId ? channel.name : 'Viewer';
  if (senderMemberId !== stream.creatorMemberId) {
    try {
      const profile = await wixData.get('Members/PublicData', senderMemberId, { suppressAuth: true });
      const publicName = profile && (profile.nickname || profile.title);
      if (typeof publicName === 'string' && publicName.trim()) {
        senderName = publicName.trim().slice(0, 80);
      }
    } catch (_) {
      senderName = 'Viewer';
    }
  }
  const cutoff = new Date(Date.now() - 10000);
  const recent = await wixData.query(CHAT)
    .eq('liveStreamId', streamId)
    .eq('senderMemberId', senderMemberId)
    .ge('createdAt', cutoff)
    .limit(5)
    .find({ suppressAuth: true });
  if (recent.items.length >= 5) {
    throw new Error('The live-chat rate limit is five messages per ten seconds.');
  }

  const createdAt = new Date();
  const created = await wixData.insert(CHAT, {
    liveStreamId: streamId,
    mediaItemId: stream.mediaItemId,
    creatorChannelId: stream.creatorChannelId,
    senderMemberId,
    senderName,
    body,
    status: 'published',
    createdAt
  }, { suppressAuth: true });
  return publicMessage(created, stream, channel);
}

async function removeMessage(input, moderatorMemberId, channelOwnerOnly) {
  const messageId = requiredText(input.messageId, 'Chat message ID', 100);
  const message = await wixData.get(CHAT, messageId, { suppressAuth: true });
  if (!message || message.status !== 'published') {
    throw new Error('The live-chat message is not available for moderation.');
  }
  if (channelOwnerOnly) {
    const channel = await wixData.get(CHANNELS, message.creatorChannelId, { suppressAuth: true });
    if (!channel || channel.memberId !== moderatorMemberId) {
      throw new Error('Only the owner of this creator channel can moderate its live chat.');
    }
  }
  const updated = await wixData.update(CHAT, {
    ...message,
    status: 'removed',
    moderatedAt: new Date(),
    moderatedBy: moderatorMemberId,
    moderationNote: typeof input.note === 'string' ? input.note.trim().slice(0, 500) : ''
  }, { suppressAuth: true });
  return { messageId: updated._id, status: updated.status };
}

export async function moderateMyChannelChatMessage(input = {}) {
  return removeMessage(input, memberId(), true);
}

export async function moderateChatMessage(input = {}) {
  return removeMessage(input, memberId(), false);
}

export async function reportLiveChatMessage(input = {}) {
  const reporterMemberId = memberId();
  const messageId = requiredText(input.messageId, 'Chat message ID', 100);
  const reason = requiredText(input.reason, 'Report reason', 30);
  if (!REPORT_REASONS.includes(reason)) throw new Error('Unsupported live-chat report reason.');

  const message = await wixData.get(CHAT, messageId, { suppressAuth: true });
  if (!message || message.status !== 'published') {
    throw new Error('Only published live-chat messages can be reported.');
  }
  if (message.senderMemberId === reporterMemberId) {
    throw new Error('A member cannot report their own live-chat message.');
  }

  const existing = await wixData.query(REPORTS)
    .eq('chatMessageId', messageId)
    .eq('reporterMemberId', reporterMemberId)
    .eq('status', 'open')
    .limit(1)
    .find({ suppressAuth: true });
  if (existing.items.length) {
    return { _id: existing.items[0]._id, status: 'open', alreadyReported: true };
  }

  const cutoff = new Date(Date.now() - 24 * 60 * 60 * 1000);
  const recentReports = await wixData.query(REPORTS)
    .eq('reporterMemberId', reporterMemberId)
    .ge('createdAt', cutoff)
    .limit(10)
    .find({ suppressAuth: true });
  if (recentReports.items.length >= 10) {
    throw new Error('The live-chat report limit is ten reports per 24 hours.');
  }

  const created = await wixData.insert(REPORTS, {
    liveStreamId: message.liveStreamId,
    chatMessageId: message._id,
    creatorChannelId: message.creatorChannelId,
    reporterMemberId,
    reason,
    details: typeof input.details === 'string' ? input.details.trim().slice(0, 2000) : '',
    status: 'open',
    createdAt: new Date()
  }, { suppressAuth: true });

  return { _id: created._id, status: created.status, alreadyReported: false };
}

export async function getMyLiveChatReports(options = {}) {
  const reporterMemberId = memberId();
  const requested = Number(options.limit);
  const limit = Math.min(Math.max(Number.isFinite(requested) && requested ? requested : 50, 1), 100);
  const result = await wixData.query(REPORTS)
    .eq('reporterMemberId', reporterMemberId)
    .descending('createdAt')
    .limit(limit)
    .find({ suppressAuth: true });
  return {
    items: result.items.map(item => ({
      _id: item._id,
      chatMessageId: item.chatMessageId,
      liveStreamId: item.liveStreamId,
      reason: item.reason,
      details: item.details || '',
      status: item.status,
      createdAt: item.createdAt,
      resolution: item.resolution || '',
      reviewNote: item.reviewNote || ''
    }))
  };
}

export async function listLiveChatReports(options = {}) {
  const requested = Number(options.limit);
  const limit = Math.min(Math.max(Number.isFinite(requested) && requested ? requested : 50, 1), 100);
  const status = options.status === undefined ? 'open' : requiredText(options.status, 'Report status', 20);
  if (!['open', 'resolved', 'dismissed'].includes(status)) {
    throw new Error('Unsupported live-chat report status.');
  }
  const result = await wixData.query(REPORTS)
    .eq('status', status)
    .ascending('createdAt')
    .limit(limit)
    .find({ suppressAuth: true });

  const items = await Promise.all(result.items.map(async report => {
    let message = null;
    try {
      message = await wixData.get(CHAT, report.chatMessageId, { suppressAuth: true });
    } catch (_) {
      message = null;
    }
    return {
      _id: report._id,
      liveStreamId: report.liveStreamId,
      chatMessageId: report.chatMessageId,
      creatorChannelId: report.creatorChannelId,
      reporterMemberId: report.reporterMemberId,
      reason: report.reason,
      details: report.details || '',
      status: report.status,
      createdAt: report.createdAt,
      reviewedAt: report.reviewedAt,
      reviewedBy: report.reviewedBy || '',
      resolution: report.resolution || '',
      reviewNote: report.reviewNote || '',
      messageBody: message ? message.body : '',
      senderName: message ? message.senderName || 'Viewer' : '',
      messageStatus: message ? message.status : 'unavailable'
    };
  }));
  return { items };
}

export async function resolveLiveChatReport(input = {}) {
  const reviewerMemberId = memberId();
  const reportId = requiredText(input.reportId, 'Report ID', 100);
  const status = requiredText(input.status, 'Report status', 20);
  const resolution = requiredText(input.resolution, 'Resolution', 30);
  const reviewNote = typeof input.reviewNote === 'string' ? input.reviewNote.trim().slice(0, 1000) : '';
  if (!['resolved', 'dismissed'].includes(status)) {
    throw new Error('Live-chat report status must be resolved or dismissed.');
  }
  if (!['remove_message', 'no_action', 'other'].includes(resolution)) {
    throw new Error('Unsupported live-chat report resolution.');
  }
  if (resolution === 'remove_message' && status !== 'resolved') {
    throw new Error('Removing a reported message requires a resolved report.');
  }

  const report = await wixData.get(REPORTS, reportId, { suppressAuth: true });
  if (!report) throw new Error('Live-chat report was not found.');
  if (report.status !== 'open') throw new Error('Only open live-chat reports can be reviewed.');

  let messageStatus = 'unavailable';
  if (resolution === 'remove_message') {
    const message = await wixData.get(CHAT, report.chatMessageId, { suppressAuth: true });
    if (message) {
      if (message.status === 'published') {
        const updatedMessage = await wixData.update(CHAT, {
          ...message,
          status: 'removed',
          moderatedAt: new Date(),
          moderatedBy: reviewerMemberId,
          moderationNote: reviewNote || 'Removed after viewer live-chat report.'
        }, { suppressAuth: true });
        messageStatus = updatedMessage.status;
      } else {
        messageStatus = message.status;
      }
    }
  }

  const updated = await wixData.update(REPORTS, {
    ...report,
    status,
    resolution,
    reviewNote,
    reviewedBy: reviewerMemberId,
    reviewedAt: new Date()
  }, { suppressAuth: true });
  return {
    _id: updated._id,
    status: updated.status,
    resolution: updated.resolution,
    messageStatus
  };
}

export async function banLiveChatMember(input = {}) {
  const moderatorMemberId = memberId();
  const creatorChannelId = requiredText(input.creatorChannelId, 'Creator channel ID', 100);
  const bannedMemberId = requiredText(input.bannedMemberId, 'Member ID', 100);
  if (bannedMemberId === moderatorMemberId) throw new Error('A channel owner cannot ban their own account.');
  const channel = await wixData.get(CHANNELS, creatorChannelId, { suppressAuth: true });
  if (!channel || channel.memberId !== moderatorMemberId) {
    throw new Error('Only the creator-channel owner can manage its live-chat bans.');
  }
  if (bannedMemberId === channel.memberId) throw new Error('The creator-channel owner cannot be banned from their own channel.');

  const durationMinutes = input.durationMinutes === undefined ? 0 : Number(input.durationMinutes);
  if (!Number.isInteger(durationMinutes) || durationMinutes < 0 || durationMinutes > 43200) {
    throw new Error('Timeout duration must be zero (permanent) or between 1 and 43,200 minutes.');
  }
  const reason = typeof input.reason === 'string' ? input.reason.trim().slice(0, 500) : '';
  const createdAt = new Date();
  const expiresAt = durationMinutes === 0 ? null : new Date(createdAt.getTime() + durationMinutes * 60000);

  const existing = await wixData.query(BANS)
    .eq('creatorChannelId', creatorChannelId)
    .eq('bannedMemberId', bannedMemberId)
    .eq('status', 'active')
    .limit(1)
    .find({ suppressAuth: true });

  let ban;
  if (existing.items.length) {
    ban = await wixData.update(BANS, {
      ...existing.items[0],
      moderatorMemberId,
      reason,
      status: 'active',
      createdAt,
      expiresAt,
      liftedAt: null,
      liftedBy: '',
      liftReason: ''
    }, { suppressAuth: true });
  } else {
    ban = await wixData.insert(BANS, {
      creatorChannelId,
      bannedMemberId,
      moderatorMemberId,
      reason,
      status: 'active',
      createdAt,
      expiresAt,
      liftedAt: null,
      liftedBy: '',
      liftReason: ''
    }, { suppressAuth: true });
  }

  return {
    _id: ban._id,
    creatorChannelId,
    bannedMemberId,
    status: ban.status,
    expiresAt: ban.expiresAt,
    permanent: !ban.expiresAt
  };
}

export async function unbanLiveChatMember(input = {}) {
  const moderatorMemberId = memberId();
  const creatorChannelId = requiredText(input.creatorChannelId, 'Creator channel ID', 100);
  const banId = requiredText(input.banId, 'Live-chat ban ID', 100);
  const channel = await wixData.get(CHANNELS, creatorChannelId, { suppressAuth: true });
  if (!channel || channel.memberId !== moderatorMemberId) {
    throw new Error('Only the creator-channel owner can manage its live-chat bans.');
  }
  const ban = await wixData.get(BANS, banId, { suppressAuth: true });
  if (!ban || ban.creatorChannelId !== creatorChannelId || ban.status !== 'active') {
    throw new Error('An active ban for this creator channel was not found.');
  }
  const updated = await wixData.update(BANS, {
    ...ban,
    status: 'lifted',
    liftedAt: new Date(),
    liftedBy: moderatorMemberId,
    liftReason: typeof input.reason === 'string' ? input.reason.trim().slice(0, 500) : ''
  }, { suppressAuth: true });
  return { _id: updated._id, status: updated.status, liftedAt: updated.liftedAt };
}

export async function getMyLiveChatBans(input = {}) {
  const moderatorMemberId = memberId();
  const creatorChannelId = requiredText(input.creatorChannelId, 'Creator channel ID', 100);
  const channel = await wixData.get(CHANNELS, creatorChannelId, { suppressAuth: true });
  if (!channel || channel.memberId !== moderatorMemberId) {
    throw new Error('Only the creator-channel owner can view its live-chat bans.');
  }
  const status = input.status === undefined ? 'active' : requiredText(input.status, 'Ban status', 20);
  if (!['active', 'lifted', 'expired', 'all'].includes(status)) {
    throw new Error('Unsupported live-chat ban status.');
  }
  const query = wixData.query(BANS).eq('creatorChannelId', creatorChannelId);
  const filtered = status === 'all' ? query : query.eq('status', status);
  const result = await filtered.descending('createdAt').limit(100).find({ suppressAuth: true });
  const items = await Promise.all(result.items.map(async item => {
    let current = item;
    if (current.status === 'active' && current.expiresAt &&
        new Date(current.expiresAt).getTime() <= Date.now()) {
      current = await wixData.update(BANS, {
        ...current,
        status: 'expired'
      }, { suppressAuth: true });
    }
    return {
      _id: current._id,
      bannedMemberId: current.bannedMemberId,
      moderatorMemberId: current.moderatorMemberId,
      reason: current.reason || '',
      status: current.status,
      createdAt: current.createdAt,
      expiresAt: current.expiresAt,
      liftedAt: current.liftedAt,
      liftedBy: current.liftedBy || '',
      liftReason: current.liftReason || '',
      permanent: !current.expiresAt
    };
  }));
  return { items };
}
