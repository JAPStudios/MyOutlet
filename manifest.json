{
    "manifest_version": 3,
    "name": "MyOutlet",
    "version": "1.0.1",
    "description": "Turn your ordinary YouTube into MyOutlet!",
    "author": "JAPStudios",
    "browser_action": {
      "default_popup": "popup.html",
      "default_title": "MyOutlet",
      "default_icon": {
        "16": "icons/MO_small.jpg",
        "48": "icons/MO_medium.jpg",
        "128": "icons/MO_large.jpg"
      }
    },
    "permissions": [
      "activeTab",
      "https://www.tiktok.com/*",
      "https://www.youtube.com/*",
      "https://studio.youtube.com/*",
      "https://www.twitch.tv/*",
      "https://dashboard.twitch.tv/*"
    ],
    "content_scripts": [
      {
        "matches": [
          "https://www.tiktok.com/*",
          "https://www.youtube.com/*",
          "https://studio.youtube.com/*",
          "https://www.twitch.tv/*",
          "https://dashboard.twitch.tv/*"
        ],
        "css": ["styles.css"],
        "js": ["content.js"]
      }
    ],
    "background": {
      "service_worker": "background.js"
    }
}